# VectorMind Environment Configuration — EXAMPLE
# Copy this to .env and fill in your real values.
# NEVER commit .env to git.

# ── LLM Backend ───────────────────────────────────────────────────────────
# "gemini" = Google Gemini API (free tier, cloud — recommended for deployment)
# "ollama" = Local Ollama (requires ollama serve running on your machine)
LLM_BACKEND=gemini

# ── Gemini API (required when LLM_BACKEND=gemini) ─────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_GEN_MODEL=gemini-1.5-flash

# ── Ollama (only needed when LLM_BACKEND=ollama) ──────────────────────────
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GEN_MODEL=llama3.2

# ── Application ───────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (simple, good for single-server deployment):
DATABASE_URL=sqlite:///./vectormind.db
# PostgreSQL (recommended for multi-user production):
# DATABASE_URL=postgresql+psycopg2://vectormind:your_password@localhost:5432/vectormind

# ── JWT Authentication ────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_strong_random_secret_32_chars_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS — add your deployed frontend URL here ────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
