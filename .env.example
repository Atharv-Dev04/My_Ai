# VectorMind Environment Configuration

# ── Application Environment ───────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Relational Database (SQLAlchemy 2.x / PostgreSQL or SQLite) ───────────
# For PostgreSQL (Production):
# DATABASE_URL=postgresql+psycopg2://vectormind:secret_password@localhost:5432/vectormind
# For Local Development / Lightweight Persistence:
DATABASE_URL=sqlite:///./vectormind.db

# ── JWT Authentication & Security ─────────────────────────────────────────
# Change this secret in production! Generate with: openssl rand -hex 32
JWT_SECRET=super_secret_vectormind_jwt_key_for_development_purposes_only_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Local Ollama Embeddings & LLM Service ──────────────────────────────────
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GEN_MODEL=llama3.2
